Html = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"display(pd\",\n  \"rows\": 6,\n  \"fields\": [\n    {\n      \"column\": \"\\u5957\\u4ef6\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 6,\n        \"samples\": [\n          \"torch\",\n          \"numpy\",\n          \"huggingface-hub\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"\\u7248\\u672c\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 6,\n        \"samples\": [\n          \"2.14.1+cu130\",\n          \"2.4.6\",\n          \"1.33.0\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","id":"d01edd8f","metadata":{"id":"d01edd8f"},"source":["## 3. 上傳教材 ZIP\n","\n","執行後選擇第一版教材 ZIP。程式只解開 TXT；README、CSV、問題集不會匯入知識庫。中文檔名由 Python 的 ZIP 工具讀取。\n","\n","每次執行這格會建立新的暫存資料夾，避免上一次的教材混進來。若上傳失敗，重新執行本格即可。後面的格子請重新依序執行。"]},{"cell_type":"code","execution_count":6,"id":"2274f6a2","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":295},"id":"2274f6a2","outputId":"4f767747-a197-49b7-ecf6-db06d79143e7","executionInfo":{"status":"ok","timestamp":1795000642524,"user_tz":-480,"elapsed":12518,"user":{"displayName":"15黃渝晴","userId":"00994706994230549192"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-ca4505b4-4819-4ab9-b446-4ae14afb3db4\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-ca4505b4-4819-4ab9-b446-4ae14afb3db4\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving rag-data.zip to rag-data.zip\n","教材： rag-data.zip\n","TXT 數量： 10\n","• 01_品牌理念與核心價值.txt\n","• 02_基底茶葉風味與咖啡因指南.txt\n","• 03_牧場鮮奶與經典拿鐵系列.txt\n","• 04_手作芋頭與特調飲品系列.txt\n","• 05_季節限定與果茶系列.txt\n","• 06_加料配料與熱量表指南.txt\n","• 07_會員集點優惠與常見 QA.txt\n","• 08_門市客訴與突發狀況處理 SOP.txt\n","• 09_甜度冰塊與飲品保存規範.txt\n","• 10_特殊飲食需求與過敏原建議.txt\n"]}],"source":["from google.colab import files\n","\n","uploaded = files.upload()\n","zip_names = [name for name in uploaded if name.lower().endswith(\".zip\")]\n","if len(zip_names) != 1:\n","    raise ValueError(\"請一次上傳一個教材 ZIP 檔。\")\n","\n","archive_name = zip_names[0]\n","archive_bytes = uploaded[archive_name]\n","SOURCE_ARCHIVE_SHA256 = hashlib.sha256(archive_bytes).hexdigest()\n","DATA_DIR = Path(tempfile.mkdtemp(prefix=\"rag_documents_\"))\n","\n","# 僅解開 TXT，並確保 ZIP 中的路徑不會寫到暫存資料夾外。\n","import io\n","with zipfile.ZipFile(io.BytesIO(archive_bytes)) as archive:\n","    members = [\n","        member for member in archive.infolist()\n","        if not member.is_dir()\n","        and member.filename.lower().endswith(\".txt\")\n","        and not any(part.startswith((\".\", \"__MACOSX\")) for part in Path(member.filename).parts)\n","    ]\n","    if not members:\n","        raise ValueError(\"ZIP 中找不到 TXT；請確認使用第一版教材，或準備自己的 TXT。\")\n","    destinations = set()\n","    for member in members:\n","        target = (DATA_DIR / member.filename).resolve()\n","        if not target.is_relative_to(DATA_DIR.resolve()):\n","            raise ValueError(f\"ZIP 包含不適當的檔案路徑：{member.filename}\")\n","        if target in destinations:\n","            raise ValueError(f\"ZIP 有重複檔名：{member.filename}\")\n","        destinations.add(target)\n","        target.parent.mkdir(parents=True, exist_ok=True)\n","        target.write_bytes(archive.read(member))\n","\n","txt_paths = sorted(DATA_DIR.rglob(\"*.txt\"), key=lambda p: p.relative_to(DATA_DIR).as_posix())\n","# 亦支援大寫 .TXT。\n","txt_paths = sorted(\n","    [p for p in DATA_DIR.rglob(\"*\") if p.is_file() and p.suffix.lower() == \".txt\"],\n","    key=lambda p: p.relative_to(DATA_DIR).as_posix(),\n",")\n","print(\"教材：\", archive_name)\n","print(\"TXT 數量：\", len(txt_paths))\n","for path in txt_paths:\n","    print(\"•\", path.relative_to(DATA_DIR).as_posix())\n","if EXPECTED_DOCUMENT_COUNT is not None and len(txt_paths) != EXPECTED_DOCUMENT_COUNT:\n","    print(f\"提醒：本次為 {len(txt_paths)} 篇，與原教材的 {EXPECTED_DOCUMENT_COUNT} 篇不同；仍可繼續。\")"]},{"cell_type":"markdown","id":"73c3761e","metadata":{"id":"73c3761e"},"source":["## 4. 先看一篇原始文件\n","\n","請觀察「標題」「來源網址」「教材整理日期」「【內容】」「【檢索練習問題】」等欄位。不是每個欄位都適合送進 embedding。\n","\n","本教材只取標題與正文。若把文件裡的練習問題也送進去，搜尋可能直接命中題目，無法公平觀察正文的檢索效果。\n","\n","可修改 `SAMPLE_INDEX`，換看其他文章。"]},{"cell_type":"code","execution_count":10,"id":"77776cc4","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"77776cc4","outputId":"f19e542f-61cb-45d0-93fb-1b77687eb6bc","executionInfo":{"status":"ok","timestamp":1795000712358,"user_tz":-480,"elapsed":57,"user":{"displayName":"15黃渝晴","userId":"00994706994230549192"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["檔名： 01_品牌理念與核心價值.txt\n","==================================================\n","【品牌理念與核心價值】\n","\n","1. 品牌起源與堅持\n","「牧夏茶飲（Milksha Craft Tea）」創立於台灣台南，初衷是希望打造一杯「連自己孩子都能安心天天喝」的健康手搖飲。我們堅持不使用奶精粉、化學香精或人工色素，所有鮮奶系列飲品皆採用台灣在地契作牧場直送的 100% 純鮮乳，搭配每日新鮮現煮的台灣原葉茶湯，呈現最純粹的自然茶香與乳香。\n","\n","2. 三大品質承諾\n","- 鮮乳承諾：嚴選榮獲國家級品質認證的在地牧場鮮乳，絕不添加任何奶粉還原或植物性奶油，保留最濃郁滑順的天然乳脂香氣。\n","- 原葉承諾：拒絕使用碎茶末與茶精，精選南投名間、鹿谷及花蓮瑞穗等地的優質原葉茶，每桶茶湯超過 4 小時未售完即刻倒掉重煮，確保茶湯不苦澀。\n","- 手作承諾：店內珍珠、芋泥、仙草凍與果醬皆堅持每日門市新鮮現煮或由中央廚房低溫冷鏈配送，不添加防腐劑。\n","\n","3. 門市服務精神\n","我們相信手搖飲不只是解渴的飲料，更是傳遞日常溫暖的媒介。每位夥伴在接待顧客時，都應保持微笑、主動詢問飲品偏好，並在遞交飲料時給予真誠的祝福。\n","\n"]}],"source":["SAMPLE_INDEX = 0\n","sample_path = txt_paths[SAMPLE_INDEX]\n","try:\n","    sample_raw = sample_path.read_text(encoding=\"utf-8-sig\")\n","except UnicodeDecodeError as exc:\n","    raise ValueError(f\"{sample_path.name} 不是可讀取的 UTF-8 文字。\") from exc\n","print(\"檔名：\", sample_path.name)\n","print(\"=\" * 50)\n","print(sample_raw)"]},{"cell_type":"markdown","id":"a08e408f","metadata":{"id":"a08e408f"},"source":["## 5. 第一個可修改函式：取出 RAG 文字\n","\n","`extract_rag_text(raw_text)` 回傳「標題＋【內容】正文」。找到【內容】後，讀到下一個【區段標題】為止；練習問題和提醒不會混入。\n","\n","**換自己的資料，主要修改這個函式。** 比如你的文件以 `正文：` 開始，就修改擷取規則。若找不到正文，本函式明確報錯，不擅自把整份文件拿去 embedding。\n","\n","這個回傳值會原樣保存；未來檢索後也將它交給 LLM，確保搜尋與回答使用同一份內容。"]},{"cell_type":"code","execution_count":19,"id":"ca9eb7e0","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ca9eb7e0","outputId":"298b6fed-621c-44c2-83ab-1bf0c8983759","executionInfo":{"status":"ok","timestamp":1795001722058,"user_tz":-480,"elapsed":62,"user":{"displayName":"15黃渝晴","userId":"00994706994230549192"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["1. 品牌起源與堅持\n","「牧夏茶飲（Milksha Craft Tea）」創立於台灣台南，初衷是希望打造一杯「連自己孩子都能安心天天喝」的健康手搖飲。我們堅持不使用奶精粉、化學香精或人工色素，所有鮮奶系列飲品皆採用台灣在地契作牧場直送的 100% 純鮮乳，搭配每日新鮮現煮的台灣原葉茶湯，呈現最純粹的自然茶香與乳香。\n","\n","2. 三大品質承諾\n","- 鮮乳承諾：嚴選榮獲國家級品質認證的在地牧場鮮乳，絕不添加任何奶粉還原或植物性奶油，保留最濃郁滑順的天然乳脂香氣。\n","- 原葉承諾：拒絕使用碎茶末與茶精，精選南投名間、鹿谷及花蓮瑞穗等地的優質原葉茶，每桶茶湯超過 4 小時未售完即刻倒掉重煮，確保茶湯不苦澀。\n","- 手作承諾：店內珍珠、芋泥、仙草凍與果醬皆堅持每日門市新鮮現煮或由中央廚房低溫冷鏈配送，不添加防腐劑。\n","\n","3. 門市服務精神\n","我們相信手搖飲不只是解渴的飲料，更是傳遞日常溫暖的媒介。每位夥伴在接待顧客時，都應保持微笑、主動詢問飲品偏好，並在遞交飲料時給予真誠的祝福。\n","\n","擷取後字元數： 433\n"]}],"source":["def extract_rag_text(raw_text):\n","    \"\"\"從本教材 TXT 取出標題與正文；換資料時修改這裡。\"\"\"\n","    normalized = raw_text.lstrip(\"\\ufeff\").replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n","    title_match = re.search(r\"^標題[：:]\\s*(.+)$\", normalized, flags=re.MULTILINE)\n","    content_match = re.search(\n","        r\"^【[^】]+】[ \\t]*\\n(?P<body>.*?)(?=^【[^】\\n]+】|\\Z)\",\n","        normalized,\n","        flags=re.MULTILINE | re.DOTALL,\n","    )\n","    if content_match is None or not content_match.group(\"body\").strip():\n","        raise ValueError(\"找不到非空的【內容】正文；請修改 extract_rag_text() 以配合文件格式。\")\n","    title = title_match.group(1).strip() if title_match else \"\"\n","    body = content_match.group(\"body\").strip()\n","    return f\"{title}\\n\\n{body}\" if title else body\n","\n","sample_rag_text = extract_rag_text(sample_raw)\n","print(sample_rag_text)\n","print(\"\\n擷取後字元數：\", len(sample_rag_text))"]},{"cell_type":"markdown","id":"04d3b092","metadata":{"id":"04d3b092"},"source":["## 6. 第二個可修改函式：取出 metadata\n","\n","`extract_metadata(raw_text, filename)` 回傳標題、網址、日期、檔名和文件性質。metadata 是追溯資料用的資訊，不會整包送進 embedding。\n","\n","**換自己的資料，可在這裡增減欄位。** 例如食譜可以增加料理類型，課程介紹可以增加學期。來源與日期找不到時用 `None`，不自行捏造；標題缺失時使用檔名。\n","\n","這裡的 `date` 是教材整理日期，不是法規生效日期。保留「教學改寫摘要」的性質，避免後續展示誤稱官方原文。"]},{"cell_type":"code","execution_count":16,"id":"eaffbd5d","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"eaffbd5d","outputId":"1e8e6125-b524-41b2-85ae-93f23e4834e9","executionInfo":{"status":"ok","timestamp":1795000899158,"user_tz":-480,"elapsed":61,"user":{"displayName":"15黃渝晴","userId":"00994706994230549192"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["{\n","  \"title\": \"01_品牌理念與核心價值\",\n","  \"source_url\": null,\n","  \"date\": null,\n","  \"filename\": \"01_品牌理念與核心價值.txt\",\n","  \"document_type\": \"未標示\"\n","}\n"]}],"source":["def extract_metadata(raw_text, filename):\n","    \"\"\"取出本教材的描述資訊；換資料時修改這裡。\"\"\"\n","    normalized = raw_text.lstrip(\"\\ufeff\").replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n","    def read_field(name):\n","        match = re.search(rf\"^{re.escape(name)}[：:][ \\t]*(.*)$\", normalized, flags=re.MULTILINE)\n","        return match.group(1).strip() or None if match else None\n","\n","    return {\n","        \"title\": read_field(\"標題\") or Path(filename).stem,\n","        \"source_url\": read_field(\"來源網址\"),\n","        \"date\": read_field(\"教材整理日期\"),\n","        \"filename\": filename,\n","        \"document_type\": read_field(\"資料類型\") or \"未標示\",\n","    }\n","\n","sample_metadata = extract_metadata(sample_raw, sample_path.relative_to(DATA_DIR).as_posix())\n","print(json.dumps(sample_metadata, ensure_ascii=False, indent=2))"]},{"cell_type":"markdown","id":"f647fe1a","metadata":{"id":"f647fe1a"},"source":["## 7. 批次整理成統一格式\n","\n","把兩個函式組合起來，每篇得到 `doc_id`、`text` 和 `metadata`。檔案先排序，再按順序給編號；只要教材及排序不變，編號便相同。新增文件可能改變編號，因此需要整套重建索引與對照。\n","\n","請檢查列表中每篇是否有標題、正文及來源。缺少 metadata 會提醒；正文缺失則停止並指出檔名，讓你回到前兩格修改函式。"]},{"cell_type":"code","execution_count":21,"id":"2e5e4b10","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":784},"id":"2e5e4b10","outputId":"1bbda7ac-51d0-4c68-f575-de950ec0b024","executionInfo":{"status":"ok","timestamp":1795002457498,"user_tz":-480,"elapsed":63,"user":{"displayName":"15黃渝晴","userId":"00994706994230549192"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["    doc_id                  標題  正文含標題字元數    來源  整理日期\n","0  doc_001        01_品牌理念與核心價值       433  None  None\n","1  doc_002     02_基底茶葉風味與咖啡因指南       874  None  None\n","2  doc_003      03_牧場鮮奶與經典拿鐵系列       737  None  None\n","3  doc_004      04_手作芋頭與特調飲品系列       635  None  None\n","4  doc_005        05_季節限定與果茶系列       808  None  None\n","5  doc_006       06_加料配料與熱量表指南       610  None  None\n","6  doc_007     07_會員集點優惠與常見 QA       858  None  None\n","7  doc_008  08_門市客訴與突發狀況處理 SOP       970  None  None\n","8  doc_009      09_甜度冰塊與飲品保存規範       648  None  None\n","9  doc_010     10_特殊飲食需求與過敏原建議       684  None  None"],"text/html":["\n","  <div id=\"df-73d115d9-7bb4-40ff-b1a4-a8fc30b950ff\" class=